# Public backend configuration used by both the browser and TanStack server functions.
# Copy this file to .env and replace the values with the project URL and publishable key.
VITE_SUPABASE_URL=https://your-project.example
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

SUPABASE_URL=https://your-project.example
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_PROJECT_ID=your-project-id

# Optional: only the Admin > Accounts page needs a server-only administrator key.
# Never prefix this with VITE_, expose it in browser code, or commit its value.
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-administrator-key